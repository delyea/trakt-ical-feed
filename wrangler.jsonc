{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trakt-serverless-ical",
	"main": "src/index.tsx",
	"compatibility_date": "2026-03-12",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public"
	},
	// Replace these IDs with the output of `wrangler d1 create trakt-ical-db`
	// and `wrangler kv namespace create SESSIONS`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trakt-ical-db",
			"database_id": "5869c0d8-8e3c-4cdc-9582-8b4b5234f98e"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "c6463daba29346fb9b7b7798bf9e4a86"
		}
	]
}
