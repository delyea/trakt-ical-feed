{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trakt-serverless-ical",
	"main": "src/index.tsx",
	"compatibility_date": "2026-03-12",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public"
	},
	// Replace these IDs with the output of `wrangler d1 create trakt-ical-db`
	// and `wrangler kv namespace create SESSIONS`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trakt-ical-db",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
		}
	]
}
